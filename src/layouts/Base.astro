---
import '@fontsource-variable/jost/wght.css';
import '../styles/global.css';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props { title: string; description: string; noindex?: boolean; overlayHeader?: boolean; ogImage?: string; }
const { title, description, noindex = false, overlayHeader = false, ogImage = '/og-image.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: `${site.url}/`,
  telephone: '+1-604-808-8667',
  email: site.email,
  logo: `${site.url}/brand/aksh-logo-full.svg`,
  image: ogUrl,
  description: site.description,
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  knowsAbout: site.services,
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1A2F3A" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>
      document.documentElement.classList.add('js-on');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion-ok');
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <nav class="action-bar on-dark" aria-label="Quick actions">
      <a href={site.phoneHref}>Call</a>
      <a href="/contact/#quote">Get a Quote</a>
    </nav>
    <script>
      const items = document.querySelectorAll('.reveal');
      if (document.documentElement.classList.contains('motion-ok')) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
