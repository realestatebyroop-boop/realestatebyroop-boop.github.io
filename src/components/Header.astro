---
import { site } from '../site.config';
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const logo = overlay ? '/brand/aksh-logo-full-white.svg' : '/brand/aksh-logo-full.svg';
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="wrap site-header__row">
    <a class="logo" href="/" aria-label="Aksh Construction home">
      <img src={logo} alt="" width="147" height="44" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="site-nav__phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--primary" href="/contact/#quote">Request a Quote</a>
    </nav>
  </div>
</header>
<noscript><style>.nav-toggle{display:none}.site-nav{display:block;position:static;width:100%}.site-header__row{flex-wrap:wrap}</style></noscript>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
    });
  }
</script>
