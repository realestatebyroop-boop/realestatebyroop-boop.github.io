---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
---
<Base title="Page Not Found | Aksh Construction" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap narrow">
      <Eyebrow text="404" />
      <h1>Page Not Found</h1>
      <p class="lede">The page you are looking for has moved or no longer exists. Our projects, services and quote form are all a click away.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/#quote">Request a Quote</a>
        <a class="btn btn--outline" href="/">Back to Home</a>
      </div>
    </div>
  </section>
</Base>
