---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import QuoteCallout from '../../components/QuoteCallout.astro';
import { getProjects, getPhotos, getHero, city, sqft, cardDetail, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] },
  }));
}
interface Props { project: Project; prev: Project; next: Project; }
const { project: p, prev, next } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const hero = getHero(p);
const photos = getPhotos(p);
const gallery = await Promise.all(photos.map(async (ph) => ({
  ...ph,
  full: (await getImage({ src: ph.src, width: Math.min(1920, ph.src.width), format: 'webp' })).src,
})));
const contain = d.heroFit === 'contain';
const size = sqft(p);
const title = `${d.title}${size ? `, ${size}` : ''} | Aksh Construction`;
const description = d.category === 'residential'
  ? `${d.bedrooms} bedrooms, ${d.bathrooms} bathrooms, ${size}. ${d.type} in ${city(p)}, BC by Aksh Construction, family-owned with 30+ years of experience.`
  : `${d.type} in ${city(p)}, BC by Aksh Construction. Scope: ${d.scope.join(', ').toLowerCase()}.`;
const facts = [
  ['Type', d.type], ['Location', d.location], ['Bedrooms', d.bedrooms], ['Bathrooms', d.bathrooms],
  ['Size', size], ['Year', d.year], ['Scope', d.scope.join(', ')],
].filter(([, v]) => v);
const label = (x: Project) => `${x.data.title}${sqft(x) ? `, ${sqft(x)}` : ''}`;
---
<Base {title} {description}>
  <section class="page-intro page-intro--tight">
    <div class="wrap">
      <Eyebrow text={`${d.type}  ·  ${city(p)}`} />
      <h1>{d.title}</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap">
      <div class:list={['project-hero', { 'project-hero--contain': contain }]}>
        <Picture src={hero.src} formats={['avif', 'webp']} widths={[800, 1280, 1920].filter((w) => w <= hero.src.width)} sizes="(min-width: 1320px) 1224px, 100vw" alt={hero.alt} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="project-layout">
        <div>
          <dl class="facts">
            {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <div class="prose project-copy"><Content /></div>
        </div>
        {gallery.length > 1 && (
          <div>
            <h2 class="sr-only">Photo gallery</h2>
            <div class="gallery" id="gallery">
              {gallery.map((g) => (
                <a href={g.full} data-alt={g.alt} aria-label={`Open larger photo: ${g.alt}`}>
                  <Picture src={g.src} formats={['avif', 'webp']} widths={[400, 700].filter((w) => w <= g.src.width)} sizes="(min-width: 900px) 20vw, (min-width: 620px) 33vw, 50vw" alt={g.alt} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
      <nav class="pager" aria-label="More projects">
        <a href={`/projects/${prev.id}/`} rel="prev"><span>Previous project</span><strong>{label(prev)}</strong></a>
        <a href={`/projects/${next.id}/`} rel="next"><span>Next project</span><strong>{label(next)}</strong></a>
      </nav>
    </div>
  </section>
  <QuoteCallout />

  {gallery.length > 1 && (
    <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
      <div class="lightbox__stage"><img alt="" /></div>
      <p class="lightbox__count" aria-live="polite"></p>
      <button class="lightbox__close" type="button" aria-label="Close photo viewer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
      <button class="lightbox__prev" type="button" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg></button>
      <button class="lightbox__next" type="button" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg></button>
    </dialog>
  )}
</Base>
<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#gallery a')];
  if (box && links.length && typeof box.showModal === 'function') {
    const img = box.querySelector('img') as HTMLImageElement;
    const count = box.querySelector('.lightbox__count') as HTMLElement;
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      img.src = links[i].href;
      img.alt = links[i].dataset.alt ?? '';
      count.textContent = `${i + 1} of ${links.length}`;
      // Fetch the neighbour so next is instant.
      new Image().src = links[(i + 1) % links.length].href;
    };
    links.forEach((a, n) => a.addEventListener('click', (e) => {
      e.preventDefault();
      show(n);
      box.showModal();
      document.documentElement.style.overflow = 'hidden';
    }));
    box.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    box.querySelector('.lightbox__close')?.addEventListener('click', () => box.close());
    box.querySelector('.lightbox__prev')?.addEventListener('click', () => show(i - 1));
    box.querySelector('.lightbox__next')?.addEventListener('click', () => show(i + 1));
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    box.querySelector('.lightbox__stage')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) box.close();
    });
    let startX = 0;
    box.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
