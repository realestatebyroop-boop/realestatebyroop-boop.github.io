---
// GitHub Pages has no server redirects, so each old Squarespace URL gets a small static page.
import { getRedirects } from '../lib/redirects';
import { site } from '../site.config';
export async function getStaticPaths() {
  const list = await getRedirects();
  return list.map((r) => ({ params: { legacy: r.from }, props: { to: r.to } }));
}
const { to } = Astro.props;
const abs = new URL(to, site.url).href;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting | Aksh Construction</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={abs} />
    <meta name="robots" content="noindex" />
  </head>
  <body><a href={to}>This page has moved. Continue to the new page.</a></body>
</html>
